<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <!-- 概览 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="最近 7 天平均" android:textColor="#8A8A8E" android:textSize="11sp" />
            <TextView android:id="@+id/tv_avg" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#1A1A1A" android:textSize="20sp" android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="32dp" android:background="#EEEEEE" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="记录次数" android:textColor="#8A8A8E" android:textSize="11sp" />
            <TextView android:id="@+id/tv_count" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="#1A1A1A" android:textSize="20sp" android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="32dp" android:background="#EEEEEE" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="平均心率" android:textColor="#8A8A8E" android:textSize="11sp" />
            <TextView android:id="@+id/tv_hr" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="#1A1A1A" android:textSize="20sp" android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 趋势图 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="血压趋势"
                android:textColor="#1A1A1A" android:textSize="14sp" android:textStyle="bold" />

            <TextView android:id="@+id/tab_7" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="7天"
                android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="10dp"
                android:paddingTop="5dp" android:paddingBottom="5dp" />
            <TextView android:id="@+id/tab_30" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="30天"
                android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="10dp"
                android:paddingTop="5dp" android:paddingBottom="5dp" />
            <TextView android:id="@+id/tab_all" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="全部"
                android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="10dp"
                android:paddingTop="5dp" android:paddingBottom="5dp" />
        </LinearLayout>

        <com.meownote.bp.TrendView
            android:id="@+id/trend"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 时段统计 -->
    <LinearLayout
        android:id="@+id/card_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:layout_marginTop="10dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="时段平均（晨峰是重点）"
            android:textColor="#8A8A8E" android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_morning" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#1A1A1A" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="早晨 6-10" android:textColor="#9A9A9E" android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_day" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#1A1A1A" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="白天 10-18" android:textColor="#9A9A9E" android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_evening" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#1A1A1A" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="晚间 18-22" android:textColor="#9A9A9E" android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_night" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#1A1A1A" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="夜间 22-6" android:textColor="#9A9A9E" android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
